# Copy to frontend/.env.local — Next loads env from its own project root. Never commit secrets.
# The app boots without these: the marketing pages still work.
# Authenticated app routes show a "configure Supabase" empty state until URL + anon key are set.
#
# Auth (Google + password reset):
#   Dashboard → Authentication → URL configuration
#     Site URL = http://localhost:3000  (or your Vercel URL in production)
#     Redirect URLs must include:
#       http://localhost:3000/auth/callback
#       https://YOUR-DOMAIN/auth/callback
#   Dashboard → Authentication → Providers → Google = enabled
#   Confirm email / SMTP as you prefer. Password reset needs email delivery.

# --- Supabase (Postgres, Auth, Storage, Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) or legacy anon JWT — both go here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC. Required for every write: from
# migration 0012, signed-in users can read their firm's rows but cannot write them
# directly. All writes go through the API routes, which use this key.
SUPABASE_SERVICE_ROLE=your-service-role-key

# --- App origin ---
# Public URL of this deployment, e.g. https://app.your-domain. Used for links in
# confirmation and invite emails, and accepted as a same-origin host for API writes.
# Set it in production; when unset, the request URL is used.
APP_URL=

# Public contact address shown in the site footer and on the privacy, terms and security pages.
# Optional. When unset those pages point to the demo request form instead of showing an address.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Invite links ---
# HMAC key for firm invite tokens. Set a long random value in every environment
# (e.g. `openssl rand -base64 48`). Unset falls back to SUPABASE_SERVICE_ROLE,
# which ties invites to that key's rotation. Changing it voids outstanding invites.
INVITE_SIGNING_SECRET=

# --- Gemini (extraction, citation embeddings, optional CAR polish). ---
# /api/extract and /api/draft-finding both spend money on a model and both
# require a session with the matching capability. Leaving GEMINI_API_KEY unset is
# safe: extraction returns 503 and CAR drafting falls back to the grounded template.
# Citation retrieval uses gemini-embedding-001 (1536-d). Unset key fails loud
# (no zero vector); findings still insert, with citation_gate=unavailable.
# The public website assistant (/api/assistant) also uses this key to rephrase
# its curated answers; unset, it shows the curated text as written.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Factor catalogue stewardship (D8) ---
# Comma-separated emails allowed to cite or correct catalogue factors. The steward
# must also hold the lead_verifier role. Firms do not attest factors: the published
# figure is the same for every customer, so this is a platform action.
# Unset means nobody can cite or override a factor, which is the safe default.
VERIFYSTACK_STEWARD_EMAILS=

# --- Self-serve signup ---
# Self-serve signup sends a confirmation link (via Resend) before the account can
# sign in. Invited members are created confirmed. Rate limited per IP and email.
# Close it before real customers: while open, anyone can create a firm. Unset = open.
# The same gate applies to first-time Google sign-in.
#   AUTH_OPEN_SIGNUP=false                  members arrive by firm-admin invite only
#   AUTH_SIGNUP_ALLOWED_DOMAINS=your.co     restrict self-serve signup to these domains
AUTH_OPEN_SIGNUP=
AUTH_SIGNUP_ALLOWED_DOMAINS=

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Sentry (optional; omit to disable) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Team invite email delivery (optional) ---
# If RESEND_API_KEY is unset, invite links are still generated and shown in UI,
# but invite email delivery is skipped.
RESEND_API_KEY=
# Verified sender identity in Resend (or keep onboarding@resend.dev for testing).
RESEND_FROM_EMAIL=
# Where landing-page demo requests are emailed (comma-separated). Needs
# RESEND_API_KEY too; without both, the form answers "not available right now".
DEMO_REQUEST_TO=
