# Copy to frontend/.env.local — Next loads env from its own project root. Never commit secrets.
# The app boots without these: marketing + /workbench still work.
# Authenticated app routes show a "configure Supabase" empty state until URL + anon key are set.

# --- Supabase (Postgres, Auth, Storage, Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) or legacy anon JWT — both go here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC. Used for hashed uploads, signed URLs, seed.
SUPABASE_SERVICE_ROLE=your-service-role-key

# --- Gemini (extraction + optional CAR polish). Existing adapter only. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Sentry (optional; omit to disable) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
